# EmailJS Configuration
# Required for the contact form functionality in src/components/Contact.jsx
# Sign up and configure your service at https://www.emailjs.com/

# EmailJS Service ID (from the 'Email Services' tab in your dashboard)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# EmailJS Template ID (from the 'Email Templates' tab in your dashboard)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# EmailJS Public Key (from Account > API Keys / General settings)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
